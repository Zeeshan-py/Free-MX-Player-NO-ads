{
  "expo": {
    "name": "MyPlayer",
    "slug": "myplayer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zeeshan.myplayer"
    },
    "android": {
      "package": "com.zeeshan.myplayer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "WRITE_EXTERNAL_STORAGE",
        "FOREGROUND_SERVICE",
        "WRITE_SETTINGS"
      ]
    },
    "plugins": [
      [
        "react-native-vlc-media-player",
        {
          "ios": {
            "includeVLCKit": false
          },
          "android": {
            "legacyJetifier": false
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow MyPlayer to access videos from your library.",
          "savePhotosPermission": "Allow MyPlayer to save videos to your library.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "video"
          ]
        }
      ],
      "expo-document-picker",
      "expo-screen-orientation"
    ]
  }
}
